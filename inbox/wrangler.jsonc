{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "grok-bot-harness-line-inbox",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "grok-bot-harness-line-inbox",
      // Deploy to Cloudflare ボタンが、利用者のアカウントに作ったデータベースの ID に書き換える
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  "triggers": {
    // UTC の 18 時 = 日本時間の午前 3 時
    "crons": ["0 18 * * *"]
  },
  "vars": {
    // 届いたメッセージを残す日数。空なら消さない。ダッシュボードで変えた値は、次のデプロイでも残す（keep_vars）
    "RETENTION_DAYS": ""
  },
  "keep_vars": true,
  "observability": { "enabled": true }
}
